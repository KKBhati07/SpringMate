HOME=HOME=/path/to/root

# Copy to .env and set values.

# Database
DB_URL=url/to/db
DB_USERNAME=db_username
DB_PASSWORD=db_pass

# Application
SEED_SECRET=secret_key
LOCATION_API_KEY=external_api_key
SERVICE_KEY=service_key

# Auth
JWT_SECRET=jwt_secret_key
JWT_VALIDITY_DAYS= valid_days_in_number
SESSION_VALIDITY_DAYS=valid_days_in_number
OTP_EXPIRATION_MINUTES=expiry_minutes_in_number

# Email
EMAIL_ENABLED=true

# AWS
AWS_REGION=region
AWS_ACCESS_KEY_ID=your_key
AWS_BUCKET_NAME=your_bucket_name
AWS_SECRET_ACCESS_KEY=your_secret
AWS_GET_URL_EXPIRY=expiry_in_minutes
AWS_PUT_URL_EXPIRY=expiry_in_minutes
SES_SOURCE_EMAIL=noreply@yourdomain.com

# CORS
CORS_ALLOWED_ORIGINS=allowed_urls
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true

# Security headers (optional)
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=3600
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CONTENT_TYPE_OPTIONS=true
SECURITY_REFERRER_POLICY=strict_origin_when_cross_origin

# Local profile only (SSL keystore for HTTPS)
SSL_KEYSTORE_PASSWORD=changeit

# Prod profile only
PORT=port_number
SPRING_DATA_REDIS_URL=redis_url

# Monitoring (actuator / Prometheus)
PROMETHEUS_PASS=prometheus_password
