spring.application.name=springmate
# Sets the name of the Spring Boot application. Useful for identification in logs and admin tools.

#spring.dataresource.url=
# (Commented out) Unused or incorrect property. Probably intended to be spring.datasource.url.

spring.datasource.url=jdbc:postgresql://postgres:5432/marketmate
# JDBC URL to connect to the PostgreSQL database named 'marketmate' running in a container or service named 'postgres' on port 5432.

spring.datasource.username=postgres
# Database username for PostgreSQL connection.

spring.datasource.password=password
# Database password for PostgreSQL connection.

spring.jpa.hibernate.ddl-auto=update
# Tells Hibernate to automatically update the database schema to match the entity classes. Good for development but not recommended for production.

spring.devtools.restart.enabled=true
# Enables Spring Boot DevTools automatic restart feature. Changes to classpath resources trigger a context restart.

spring.datasource.driver-class-name=org.postgresql.Driver
# Specifies the JDBC driver class for PostgreSQL.

#spring.jpa.hibernate.ddl-auto=update
# (Commented out duplicate) Redundant configuration already defined above.

#spring.jpa.database-platform=org.hibernate.dialect.postgresqldialect
# (Commented out) If specified, tells Hibernate exactly which SQL dialect to use. Correct value would be `org.hibernate.dialect.PostgreSQLDialect`.
